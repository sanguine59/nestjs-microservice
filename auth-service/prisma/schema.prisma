generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

model User {
  user_id  String @id @default(uuid()) @db.VarChar(36)
  username String @db.VarChar(55)
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  country  String @db.VarChar(55)
  role     String @db.VarChar(25)

  @@map("users")
}
